# Copiar a .env y completar los valores vacíos antes de levantar los contenedores.
# MSSQL_SA_PASSWORD es obligatoria: al menos 8 caracteres con mayúsculas,
# minúsculas, números y símbolos. Docker Compose no arranca si está vacía.
MSSQL_SA_PASSWORD=
DB_NAME=ShopCart
DB_PORT=14335
APP_DB_PASSWORD=
JWT_SECRET=
# true muestra en el login los botones para entrar como cliente, operador o administrador.
# Se aplica al construir la imagen web: docker compose up --build.
VITE_MODO_DEMO=false
